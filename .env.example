PORT=4174
NODE_ENV=development

# Production/Railway: immutable manifest URL in Vercel Blob.
# The manifest points to versioned knowledge JSON documents and includes SHA-256 hashes.
VERCEL_KB_MANIFEST_URL=

# Required in production when the Vercel Blob objects are private.
BLOB_READ_WRITE_TOKEN=

# Optional allow-list for the browser dashboard.
ALLOWED_ORIGIN=http://localhost:4174

# Decision-ready summary view and offline HTML/print exports.
ASSURANCE_SUMMARY_ENABLED=true

# Evidence-gated cognitive pipeline is the standard assessment path. Provider
# keys stay server-side; browser users never enter credentials or choose models.
COGNITIVE_RATE_LIMIT_PER_MINUTE=10
COGNITIVE_MAX_CALLS_PER_RUN=180
COGNITIVE_MAX_TOKENS_PER_RUN=1500000
COGNITIVE_MAX_RUN_MS=900000
COGNITIVE_MAX_CONCURRENCY=3

# Provider credentials remain server-side. OPENAI_API_KEY takes precedence;
# GPT_API_KEY remains supported for the existing Railway configuration.
OPENAI_API_KEY=
GPT_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Live benchmark safety switch; never enable in the long-lived Railway service.
BENCHMARK_CONFIRM_LIVE_CALLS=false
BENCHMARK_PROFILE_IDS=
