{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-governance:schema:shared-definitions:2.1.0",
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "date": { "type": "string", "format": "date" },
    "domain": { "enum": ["A", "B", "C", "D", "E", "F"] },
    "capabilityId": { "type": "string", "pattern": "^[A-F][1-5]$" },
    "antipatternId": { "type": "string", "pattern": "^AP-[A-F][1-5]$" },
    "assessmentObjectId": { "type": "string", "pattern": "^(?:AP-)?[A-F][1-5]$" },
    "questionId": { "type": "string", "pattern": "^(?:AP-)?[A-F][1-5]-Q[1-3]$" },
    "evidenceId": { "type": "string", "pattern": "^EVD-(?:AP-)?[A-F][1-5]-[0-9]{3}$" },
    "findingId": { "type": "string", "pattern": "^FND-(?:AP-)?[A-F][1-5]-[0-9]{3}$" },
    "tacticId": { "type": "string", "pattern": "^TAC-(?:PURPOSE|DATA|MODELS|ARCHITECTURE|HUMAN|ACCOUNTABILITY)-(?:AP-)?[A-F][1-5]-[0-9]{2}$" },
    "releaseStatus": { "enum": ["DRAFT", "PILOT", "APPROVED", "FROZEN", "RETIRED"] },
    "lifecycleStage": { "enum": ["QUALIFICATION_AND_REGISTRATION", "DESIGN_AND_DEVELOPMENT", "VERIFICATION_AND_VALIDATION", "DEPLOYMENT", "OPERATION_AND_MONITORING", "REVIEW_AND_EVALUATION", "RETIREMENT"] },
    "technicalAssurance": { "enum": ["DECLARED", "IMPLEMENTED", "TESTED", "OPERATIONALLY_OBSERVED"] },
    "humanAssurance": { "enum": ["NOT_REQUIRED", "HUMAN_VALIDATED", "FORMALLY_APPROVED"] },
    "coverageState": { "enum": ["ASSESSED", "UNKNOWN", "NOT_APPLICABLE", "FAILED", "HUMAN_INTERPRETATION_REQUIRED"] },
    "severity": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "approvalRecord": {
      "type": "object",
      "required": ["approved_by_role", "approved_on", "approval_scope", "approved_version"],
      "properties": {
        "approved_by_role": { "type": "string", "minLength": 2 },
        "approved_on": { "$ref": "#/$defs/date" },
        "approval_scope": { "type": "string", "minLength": 10 },
        "approved_version": { "$ref": "#/$defs/semver" },
        "supersedes_version": { "oneOf": [{ "$ref": "#/$defs/semver" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "applicability": {
      "type": "object",
      "required": ["default_state", "conditions"],
      "properties": {
        "default_state": { "enum": ["APPLICABLE", "CONDITIONALLY_APPLICABLE", "NOT_APPLICABLE_BY_DEFAULT"] },
        "conditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } }
      },
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "required": ["id", "dimension", "question"],
      "properties": {
        "id": { "$ref": "#/$defs/questionId" },
        "dimension": { "enum": ["DEFINITION_AND_INTENT", "IMPLEMENTATION_AND_OPERATION", "EVIDENCE_AND_EFFECTIVENESS"] },
        "question": { "type": "string", "minLength": 10 }
      },
      "additionalProperties": false
    },
    "evidenceRequirement": {
      "type": "object",
      "required": ["id", "title", "description", "minimum_technical_assurance", "required_human_assurance"],
      "properties": {
        "id": { "$ref": "#/$defs/evidenceId" },
        "title": { "type": "string", "minLength": 3 },
        "description": { "type": "string", "minLength": 10 },
        "minimum_technical_assurance": { "$ref": "#/$defs/technicalAssurance" },
        "required_human_assurance": { "$ref": "#/$defs/humanAssurance" }
      },
      "additionalProperties": false
    },
    "evidenceRules": {
      "type": "object",
      "required": ["sufficiency", "evidence_ceiling", "false_positive_guards", "prohibited_inferences"],
      "properties": {
        "sufficiency": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } },
        "evidence_ceiling": { "type": "string", "minLength": 10 },
        "false_positive_guards": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } },
        "prohibited_inferences": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } }
      },
      "additionalProperties": false
    },
    "hardGateEffect": {
      "type": "object",
      "required": ["effect", "conditions", "override_authority"],
      "properties": {
        "effect": { "enum": ["NONE", "WARN", "BLOCK", "CONSTRAIN"] },
        "conditions": { "type": "array", "items": { "type": "string", "minLength": 5 } },
        "override_authority": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "sourceMapping": {
      "type": "object",
      "required": ["source_id", "relevant_locator", "mapping_rationale", "last_verified_on"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" },
        "relevant_locator": { "type": "string", "minLength": 3 },
        "mapping_rationale": { "type": "string", "minLength": 10 },
        "last_verified_on": { "$ref": "#/$defs/date" }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["id", "assessment_object_id", "title", "eligible_states", "severity", "human_decision_authority"],
      "properties": {
        "id": { "$ref": "#/$defs/findingId" },
        "assessment_object_id": { "$ref": "#/$defs/assessmentObjectId" },
        "title": { "type": "string", "minLength": 10 },
        "eligible_states": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["SATISFIED", "PARTIALLY_SATISFIED", "NOT_SATISFIED", "CONFIRMED_PRESENT", "PARTIALLY_PRESENT", "TESTED_ABSENT", "UNKNOWN", "NOT_APPLICABLE", "HUMAN_INTERPRETATION_REQUIRED"] } },
        "severity": { "$ref": "#/$defs/severity" },
        "human_decision_authority": { "type": "string", "minLength": 2 }
      },
      "additionalProperties": false
    },
    "tacticRef": {
      "type": "object",
      "required": ["tactic_id", "tactic_version", "relationship", "mapping_status"],
      "properties": {
        "tactic_id": { "$ref": "#/$defs/tacticId" },
        "tactic_version": { "$ref": "#/$defs/semver" },
        "relationship": { "enum": ["REMEDIATES_CAPABILITY_GAP", "REMEDIATES_ANTIPATTERN"] },
        "mapping_status": { "enum": ["DRAFT", "APPROVED"] }
      },
      "additionalProperties": false
    },
    "assuranceTarget": {
      "type": "object",
      "required": ["lifecycle_stage", "minimum_technical_assurance", "required_human_assurance"],
      "properties": {
        "lifecycle_stage": { "$ref": "#/$defs/lifecycleStage" },
        "minimum_technical_assurance": { "$ref": "#/$defs/technicalAssurance" },
        "required_human_assurance": { "$ref": "#/$defs/humanAssurance" }
      },
      "additionalProperties": false
    }
  }
}
