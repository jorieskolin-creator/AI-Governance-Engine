{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-governance:schema:tactic-catalog:2.1.0",
  "type": "object",
  "required": ["schema_version", "catalog_id", "title", "version", "release_status", "approval_record", "source_document", "mapping_source_of_truth", "authority_boundary", "catalog_rules", "tactics"],
  "properties": {
    "schema_version": { "const": "2.1.0" },
    "catalog_id": { "const": "AI-GOV-TACTIC-CATALOG" },
    "title": { "type": "string", "minLength": 5 },
    "version": { "$ref": "urn:ai-governance:schema:shared-definitions:2.1.0#/$defs/semver" },
    "release_status": { "$ref": "urn:ai-governance:schema:shared-definitions:2.1.0#/$defs/releaseStatus" },
    "approval_record": { "oneOf": [{ "$ref": "urn:ai-governance:schema:shared-definitions:2.1.0#/$defs/approvalRecord" }, { "type": "null" }] },
    "source_document": {
      "type": "object",
      "required": ["filename", "sha256", "snapshot_date", "definition_authority"],
      "properties": {
        "filename": { "type": "string", "minLength": 5 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "snapshot_date": { "$ref": "urn:ai-governance:schema:shared-definitions:2.1.0#/$defs/date" },
        "definition_authority": { "const": "USER_CONFIRMED_FINALIZED_PLAYBOOK" }
      },
      "additionalProperties": false
    },
    "mapping_source_of_truth": { "const": "TACTIC_CATALOG" },
    "authority_boundary": { "type": "string", "minLength": 20 },
    "catalog_rules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } },
    "tactics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "release_status", "approval_record", "title", "primary_mapping_text", "primary_object_mappings", "function", "control_purpose", "principal_outputs", "reassessment_text", "reassessment_targets", "completion_effect", "activation_mapping_status", "operationalization_status", "assessment_mappings", "eligible_finding_ids", "trigger_states", "prerequisite_tactic_ids", "normative_source_mappings"],
        "properties": {
          "id": { "$ref": "urn:ai-governance:schema:shared-definitions:2.1.0#/$defs/tacticId" },
          "version": { "$ref": "urn:ai-governance:schema:shared-definitions:2.1.0#/$defs/semver" },
          "release_status": { "$ref": "urn:ai-governance:schema:shared-definitions:2.1.0#/$defs/releaseStatus" },
          "approval_record": { "oneOf": [{ "$ref": "urn:ai-governance:schema:shared-definitions:2.1.0#/$defs/approvalRecord" }, { "type": "null" }] },
          "title": { "type": "string", "minLength": 5 },
          "primary_mapping_text": { "type": "string", "minLength": 2 },
          "primary_object_mappings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "urn:ai-governance:schema:shared-definitions:2.1.0#/$defs/assessmentObjectId" } },
          "function": { "type": "string", "minLength": 3 },
          "control_purpose": { "type": "string", "minLength": 20 },
          "principal_outputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
          "reassessment_text": { "type": "string", "minLength": 2 },
          "reassessment_targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "urn:ai-governance:schema:shared-definitions:2.1.0#/$defs/assessmentObjectId" } },
          "completion_effect": { "const": "NEW_EVIDENCE_AND_REASSESSMENT_REQUIRED" },
          "activation_mapping_status": { "enum": ["PENDING_KB_FINDING_MAPPING", "DRAFT", "APPROVED"] },
          "operationalization_status": { "enum": ["SOURCE_FIELDS_ONLY", "ENRICHED", "RUNTIME_READY"] },
          "assessment_mappings": {
            "type": "object",
            "required": ["capabilities", "antipatterns", "question_ids"],
            "properties": {
              "capabilities": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:ai-governance:schema:shared-definitions:2.1.0#/$defs/capabilityId" } },
              "antipatterns": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:ai-governance:schema:shared-definitions:2.1.0#/$defs/antipatternId" } },
              "question_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:ai-governance:schema:shared-definitions:2.1.0#/$defs/questionId" } }
            },
            "additionalProperties": false
          },
          "eligible_finding_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:ai-governance:schema:shared-definitions:2.1.0#/$defs/findingId" } },
          "trigger_states": { "type": "array", "uniqueItems": true, "items": { "enum": ["PARTIALLY_SATISFIED", "NOT_SATISFIED", "CONFIRMED_PRESENT", "PARTIALLY_PRESENT", "UNKNOWN", "HUMAN_INTERPRETATION_REQUIRED"] } },
          "eligibility": {
            "type": "object",
            "required": ["lifecycle_stages", "required_context"],
            "properties": {
              "lifecycle_stages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "urn:ai-governance:schema:shared-definitions:2.1.0#/$defs/lifecycleStage" } },
              "required_context": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } }
            },
            "additionalProperties": false
          },
          "prerequisite_tactic_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:ai-governance:schema:shared-definitions:2.1.0#/$defs/tacticId" } },
          "use_when": { "type": "string", "minLength": 20 },
          "owners": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
          "activities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } },
          "artifacts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
          "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } },
          "verification": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } },
          "risks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } },
          "do_not_use_when": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } },
          "blocks_transition": { "type": "string", "minLength": 10 },
          "duplicate_prevention_fingerprint": {
            "type": "object",
            "required": ["objective", "mechanism_terms", "artifact_classes", "acceptance_signature"],
            "properties": {
              "objective": { "type": "string", "minLength": 10 },
              "mechanism_terms": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
              "artifact_classes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
              "acceptance_signature": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } }
            },
            "additionalProperties": false
          },
          "normative_source_mappings": { "type": "array", "items": { "$ref": "urn:ai-governance:schema:shared-definitions:2.1.0#/$defs/sourceMapping" } }
        },
        "additionalProperties": false,
        "allOf": [
          { "if": { "properties": { "release_status": { "enum": ["APPROVED", "FROZEN"] } }, "required": ["release_status"] }, "then": { "properties": { "approval_record": { "$ref": "urn:ai-governance:schema:shared-definitions:2.1.0#/$defs/approvalRecord" } } } }
        ]
      }
    }
  },
  "additionalProperties": false,
  "allOf": [{ "if": { "properties": { "release_status": { "enum": ["APPROVED", "FROZEN"] } }, "required": ["release_status"] }, "then": { "properties": { "approval_record": { "$ref": "urn:ai-governance:schema:shared-definitions:2.1.0#/$defs/approvalRecord" } } } }]
}
