PORT=4174
NODE_ENV=development

# Optional durable orchestration store. When absent, development uses the
# process-local store. PostgreSQL checkpoints exclude raw source material.
DATABASE_URL=
COGNITIVE_RUN_LEASE_MS=1200000
COGNITIVE_RUN_HEARTBEAT_MS=30000
COGNITIVE_MAX_ACTIVE_RUNS=2
COGNITIVE_QUEUE_POLL_MS=1000

# Optional until the Maintainer publishes a hash-pinned runtime manifest.
# Unset/blank: production uses the local unpublished instrument + Playbook.
# Set only to a valid immutable Vercel Blob manifest URL; placeholders fail startup.
VERCEL_KB_MANIFEST_URL=

# Required in production when the Vercel Blob objects are private.
BLOB_READ_WRITE_TOKEN=

# Optional allow-list for the browser dashboard.
ALLOWED_ORIGIN=http://localhost:4174

# Shared write password. When set, the dashboard stays readable and the
# password is required before uploads, intake edits, or analysis. Leave
# unset for local tests. Set ADMIN_SECRET on Railway for the deployed app.
ADMIN_SECRET=

# Decision-ready summary view and offline HTML/print exports.
ASSURANCE_SUMMARY_ENABLED=true

# Evidence-gated cognitive pipeline is the standard assessment path. Provider
# keys stay server-side; browser users never enter credentials or choose models.
COGNITIVE_RATE_LIMIT_PER_MINUTE=10
COGNITIVE_MAX_CALLS_PER_RUN=180
COGNITIVE_MAX_TOKENS_PER_RUN=1500000
COGNITIVE_MAX_RUN_MS=900000
COGNITIVE_MAX_CONCURRENCY=3

# Provider credentials and model identities remain server-side.
# GPT_API_KEY remains supported as an OpenAI credential alias.
OPENAI_API_KEY=
GPT_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Validate this preset in staging with the three credentials above before switching production.
COGNITIVE_PROVIDER_PROFILE=OPENAI_ANTHROPIC_GOOGLE
# Explicit role pairs override the preset. Keep them unset to use the profile assignments.
# WORKHORSE_PROVIDER=ANTHROPIC
# WORKHORSE_MODEL=claude-sonnet-5-5

# Live benchmark safety switch; never enable in the long-lived Railway service.
BENCHMARK_CONFIRM_LIVE_CALLS=false
BENCHMARK_PROFILE_IDS=
