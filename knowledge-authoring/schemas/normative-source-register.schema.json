{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-governance:schema:normative-source-register:2.1.0",
  "type": "object",
  "required": ["schema_version", "register_type", "version", "release_status", "approval_record", "sources"],
  "properties": {
    "schema_version": { "const": "2.1.0" },
    "register_type": { "const": "NORMATIVE_SOURCE_REGISTER" },
    "version": { "$ref": "urn:ai-governance:schema:shared-definitions:2.1.0#/$defs/semver" },
    "release_status": { "$ref": "urn:ai-governance:schema:shared-definitions:2.1.0#/$defs/releaseStatus" },
    "approval_record": { "oneOf": [{ "$ref": "urn:ai-governance:schema:shared-definitions:2.1.0#/$defs/approvalRecord" }, { "type": "null" }] },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "title", "official_url", "authority_type", "jurisdiction", "effective_status", "last_verified_on", "approval_status", "owner_authority"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" },
          "title": { "type": "string", "minLength": 5 },
          "official_url": { "type": "string", "pattern": "^(?:https|internal)://" },
          "authority_type": { "enum": ["BINDING_LAW", "REGULATORY_GUIDANCE", "GOVERNMENT_GUIDANCE", "INTERNAL_PROCESS", "STANDARD", "VOLUNTARY_FRAMEWORK", "COMMUNITY_PRACTICE", "INDUSTRY_GUIDANCE", "CONTRACTUAL_REQUIREMENT"] },
          "jurisdiction": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
          "effective_status": { "type": "string", "minLength": 3 },
          "last_verified_on": { "$ref": "urn:ai-governance:schema:shared-definitions:2.1.0#/$defs/date" },
          "approval_status": { "enum": ["DRAFT", "APPROVED", "REVIEW_REQUIRED"] },
          "owner_authority": { "type": "string", "minLength": 2 }
        }, "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "allOf": [{ "if": { "properties": { "release_status": { "enum": ["APPROVED", "FROZEN"] } }, "required": ["release_status"] }, "then": { "properties": { "approval_record": { "$ref": "urn:ai-governance:schema:shared-definitions:2.1.0#/$defs/approvalRecord" } } } }]
}
